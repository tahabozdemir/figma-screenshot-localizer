{
  "name": "figma-screenshot-localizer",
  "version": "1.0.0",
  "private": true,
  "description": "Figma plugin that duplicates your App Store / Google Play screenshot frames and translates the text into 21 languages \u2014 locally, with your own API key or by hand.",
  "license": "MIT",
  "author": "Taha Bozdemir",
  "keywords": [
    "figma",
    "figma-plugin",
    "localization",
    "i18n",
    "translation",
    "screenshots",
    "app-store",
    "google-play",
    "aso",
    "deepl",
    "openai",
    "gemini"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run typecheck && node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.ui.json && tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node build.mjs --test && node --test \"test/*.test.mjs\"",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true});require('node:fs').rmSync('dist-test',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@figma/plugin-typings": "^1.100.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.67.0"
  }
}
